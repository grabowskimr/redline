{
  "name": "redline",
  "displayName": "Code Redline",
  "description": "See Claude Code\u2019s last changes and accept unreviewed files in a native VS Code diff viewer.",
  "version": "1.0.0",
  "publisher": "grabowskmr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/grabowskimr/redline.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "redline",
    "code review",
    "claude code",
    "diff",
    "unreviewed"
  ],
  "icon": "resources/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Trust the workspace to capture and compare Git snapshots. Git may execute repository configuration and filters."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Code Redline needs a local Git repository."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "redline.reviewChanges",
        "title": "Last Run",
        "category": "Code Redline",
        "icon": "$(history)"
      },
      {
        "command": "redline.reviewUnreviewed",
        "title": "Unreviewed",
        "category": "Code Redline",
        "icon": "$(checklist)"
      },
      {
        "command": "redline.pickSession",
        "title": "Choose Claude Code Session\u2026",
        "category": "Code Redline",
        "icon": "$(plug)"
      },
      {
        "command": "redline.refresh",
        "title": "Refresh Changes",
        "category": "Code Redline",
        "icon": "$(refresh)"
      },
      {
        "command": "redline.openReviewFile",
        "title": "Open Saved Diff",
        "category": "Code Redline",
        "icon": "$(diff)"
      },
      {
        "command": "redline.openWorkingFile",
        "title": "Open Working File for Editing",
        "category": "Code Redline",
        "icon": "$(go-to-file)"
      },
      {
        "command": "redline.markAllReviewed",
        "title": "Mark All Reviewed",
        "category": "Code Redline",
        "icon": "$(check-all)"
      },
      {
        "command": "redline.markReviewed",
        "title": "Mark Reviewed",
        "category": "Code Redline",
        "icon": "$(check)"
      },
      {
        "command": "redline.nextUnreviewed",
        "title": "Next Unreviewed File",
        "category": "Code Redline",
        "icon": "$(arrow-down)"
      },
      {
        "command": "redline.setUpHook",
        "title": "Set Up Claude Code Plugin",
        "category": "Code Redline",
        "icon": "$(extensions)"
      },
      {
        "command": "redline.showLog",
        "title": "Show Log",
        "category": "Code Redline",
        "icon": "$(output)"
      },
      {
        "command": "redline.focusPanel",
        "title": "Show Changes",
        "category": "Code Redline",
        "icon": "$(diff-multiple)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "redline",
          "title": "Code Redline",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "redline": [
        {
          "id": "redline.changes",
          "name": "Last run",
          "contextualTitle": "Code Redline"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "redline.reviewUnreviewed",
          "when": "view == redline.changes && redline.scope != unreviewed",
          "group": "navigation@1"
        },
        {
          "command": "redline.reviewChanges",
          "when": "view == redline.changes && redline.scope == unreviewed",
          "group": "navigation@1"
        },
        {
          "command": "redline.refresh",
          "when": "view == redline.changes",
          "group": "navigation@2"
        },
        {
          "command": "redline.pickSession",
          "when": "view == redline.changes",
          "group": "navigation@3"
        },
        {
          "command": "redline.nextUnreviewed",
          "when": "view == redline.changes",
          "group": "1_review@1"
        },
        {
          "command": "redline.markAllReviewed",
          "when": "view == redline.changes && redline.scope == unreviewed",
          "group": "1_review@2"
        },
        {
          "command": "redline.setUpHook",
          "when": "view == redline.changes",
          "group": "2_setup@1"
        },
        {
          "command": "redline.showLog",
          "when": "view == redline.changes",
          "group": "2_setup@2"
        }
      ],
      "view/item/context": [
        {
          "command": "redline.openWorkingFile",
          "when": "view == redline.changes && viewItem == redline.changedFile",
          "group": "inline@1"
        },
        {
          "command": "redline.openWorkingFile",
          "when": "view == redline.changes && viewItem == redline.changedFile",
          "group": "1_open"
        },
        {
          "command": "redline.markReviewed",
          "when": "view == redline.changes && viewItem == redline.changedFile && redline.scope == unreviewed",
          "group": "2_review"
        }
      ],
      "editor/title": [
        {
          "command": "redline.openWorkingFile",
          "when": "resourceScheme =~ /^(redline-tree|redline-empty)$/",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "redline.openWorkingFile",
          "when": "resourceScheme =~ /^(redline-tree|redline-empty)$/",
          "group": "1_redline"
        }
      ],
      "editor/context": [
        {
          "command": "redline.openWorkingFile",
          "when": "resourceScheme =~ /^(redline-tree|redline-empty)$/",
          "group": "1_redline"
        }
      ],
      "commandPalette": [
        {
          "command": "redline.openReviewFile",
          "when": "false"
        },
        {
          "command": "redline.markReviewed",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Code Redline",
      "properties": {
        "redline.reviewBase": {
          "type": "string",
          "default": "auto",
          "description": "Base ref for Unreviewed (for example origin/main). Auto uses the default branch merge-base, or a saved HEAD in local-only repositories."
        },
        "redline.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the current changed-file count in the status bar."
        },
        "redline.trace": {
          "type": "string",
          "enum": [
            "off",
            "errors",
            "verbose"
          ],
          "default": "errors",
          "description": "Verbosity of the Code Redline output channel."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check && npm run compile -- --production && vsce package --no-dependencies",
    "check": "tsc --noEmit -p ./",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "npm run check && npm run test:unit",
    "test:unit": "rm -rf out/test && tsc -p tsconfig.test.json && mocha \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile && tsc -p tsconfig.test.json && node out/test/integration/runTests.js",
    "vscode:prepublish": "npm run compile -- --production"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.1.0",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "mocha": "^10.7.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "bugs": {
    "url": "https://github.com/grabowskimr/redline/issues"
  },
  "homepage": "https://github.com/grabowskimr/redline#readme",
  "qna": false,
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  }
}
